{
  "name": "@docu/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "test:e2e": "bun test test/e2e/",
    "worker": "bun src/worker/worker.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:test": "bun scripts/schema-test.ts",
    "db:spec": "DB_TEST=1 bun test prisma/tests/",
    "db:seed": "bun scripts/db-seed.ts",
    "db:password": "bun scripts/db-set-password.ts",
    "db:bench": "bun scripts/db-bench.ts",
    "openapi": "bun scripts/openapi.ts",
    "openapi:check": "bun scripts/openapi.ts --check"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "^12.1.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bullmq": "6.3.11",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "5.2.1",
    "ioredis": "6.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "16.6.1",
    "prisma": "7.10.0",
    "supertest": "^7.1.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
