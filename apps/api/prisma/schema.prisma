// DOCU E1 — esquema base. Bitacora e HistorialOrigen son SOLO-INSERT
// (nada los actualiza ni borra; se garantiza en capa de servicio M1).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Organización y acceso (RBAC base, M2 lo completa) ----------
model Empresa {
  id            String         @id @default(uuid())
  nombre        String
  departamentos Departamento[]
  usuarios      Usuario[]
}

model Departamento {
  id         String    @id @default(uuid())
  empresaId  String
  empresa    Empresa   @relation(fields: [empresaId], references: [id])
  nombre     String
  usuarios   Usuario[]

  @@unique([empresaId, nombre])
}

model Rol {
  id       String       @id @default(uuid())
  codigo   String       @unique // admin | planeacion | calidad | almacen
  nombre   String
  usuarios UsuarioRol[]
}

model Usuario {
  id             String        @id @default(uuid())
  email          String        @unique
  nombre         String
  passwordHash   String
  empresaId      String
  empresa        Empresa       @relation(fields: [empresaId], references: [id])
  departamentoId String?
  departamento   Departamento? @relation(fields: [departamentoId], references: [id])
  roles          UsuarioRol[]
  bitacora       Bitacora[]
  creadoEn       DateTime      @default(now())
}

model UsuarioRol {
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  rolId     String
  rol       Rol     @relation(fields: [rolId], references: [id])

  @@id([usuarioId, rolId])
}

// ---------- Ingesta y validación ----------
model ArchivoOriginal {
  id             String   @id @default(uuid())
  sha256         String   @unique
  familia        String   // programa_planeacion | recepcion_rollo | inventario | excel_turno | correo_hermana | escaneado
  nombreOriginal String
  mime           String
  bytes          BigInt
  ruta           String
  estado         String   @default("RECIBIDO") // RECIBIDO | VALIDADO | EN_CUARENTENA
  metadatos      Json?
  fechaIngesta   DateTime @default(now())
  cuarentenas    Cuarentena[]
}

model Cuarentena {
  id            String          @id @default(uuid())
  archivoId     String
  archivo       ArchivoOriginal @relation(fields: [archivoId], references: [id])
  motivo        String
  reglaCodigo   String?
  estado        String          @default("ABIERTA") // ABIERTA | RESUELTA | DESCARTADA
  resueltoPorId String?
  creadoEn      DateTime        @default(now())
  resueltoEn    DateTime?
}

// ---------- Dato oficial + historial ----------
model DatoOficial {
  id                String   @id @default(uuid())
  familia           String
  claveNegocio      String   // ej. ORD-2026-0001 (única por familia)
  datos             Json
  embedding         Unsupported("vector(768)")?
  archivoId         String?
  confirmadoPorId   String?
  fechaConfirmacion DateTime?
  creadoEn          DateTime @default(now())

  @@unique([familia, claveNegocio])
}

model HistorialOrigen {
  id              String   @id @default(uuid())
  entidad         String   // DatoOficial | Programa | ...
  entidadId       String
  origenTipo      String   // archivo | regla | confirmacion | sistema
  origenRef       String
  reglaAplicada   String?
  confirmadoPorId String?
  creadoEn        DateTime @default(now())

  @@index([entidad, entidadId])
}

// ---------- Bitácora (append-only) ----------
model Bitacora {
  id        String   @id @default(uuid())
  actorId   String?
  actor     Usuario? @relation(fields: [actorId], references: [id])
  accion    String   // subir | validar | confirmar | publicar | login | ...
  entidad   String
  entidadId String
  detalle   Json?
  creadoEn  DateTime @default(now())

  @@index([entidad, entidadId])
}

// ---------- Configuración por empresa (sin código, Cfg-1/Cfg-2) ----------
model ConfigFamilia {
  id      String  @id @default(uuid())
  codigo  String  @unique
  nombre  String
  esquema Json    // columnas, obligatorios, tipos
  activa  Boolean @default(true)
}

model ReglaValidacion {
  id          String  @id @default(uuid())
  codigo      String  @unique // R-P1..R-P4, R-Q1, R-A1, R-T1
  descripcion String
  expresion   Json    // regla declarativa evaluable
  severidad   String  @default("BLOQUEO") // BLOQUEO | AVISO
  activa      Boolean @default(true)
}

// ---------- Caso Baja SterilPack ----------
model Maquina {
  id     String @id @default(uuid())
  codigo String @unique // M1..M5
  nombre String
}

model Orden {
  id       String @id @default(uuid())
  folio    String @unique // ORD-2026-XXXX
  producto String // pouch | bag
  medida   String
  estado   String @default("CREADA")
}

model Rollo {
  id          String  @id @default(uuid())
  codigo      String  @unique // R-###
  material    String
  medida      String
  certificado String? // nulo = sin certificado (R-P1)
  estado      String  @default("RECIBIDO")
}

model Programa {
  id        String   @id @default(uuid())
  ordenId   String
  maquinaId String
  fecha     DateTime @db.Date
  estado    String   @default("PROGRAMADA")

  @@unique([ordenId, maquinaId, fecha])
}

model Prueba {
  id        String  @id @default(uuid())
  tipo      String
  objetivo  String
  queCubre  String  // RF-01.. (matriz RF->prueba)
  resultado String? // PASA | FALLA | PENDIENTE
}

model Alerta {
  id            String   @id @default(uuid())
  tipo          String
  mensaje       String
  destinatarios Json
  estado        String   @default("NUEVA")
  creadoEn      DateTime @default(now())
}
