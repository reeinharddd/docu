DATABASE_URL=postgresql://docu:docu@localhost:5432/docu?schema=public
REDIS_URL=redis://localhost:6379
IA_LOCAL_ACTIVADA=true
IA_NUBE_ACTIVADA=false
JWT_SECRET=cambiar-en-tu-env-local
PORT_API=3000
PG_PORT=5432
REDIS_PORT=6379

# Google Drive/Docs — READ-ONLY and always live. Project OAuth credentials.
# The refresh token is used (grant refresh_token); the access_token
# expires and is never stored.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER=1KeJaYqEfrbD4H7hKCTIZsDMEAOolUdH4

# Project memory (index, not the source of truth)
ENGRAM_PROJECT=docu

# Systematic crawling (extra, off by default). Empty = keyless with limits.
# Used only per milestone with the lead's authorization (see .mcp.json: firecrawl).
FIRECRAWL_API_KEY=
