DATABASE_URL=postgresql://docu:docu@localhost:5432/docu?schema=public
# Shadow database used by `prisma migrate dev`. Optional but recommended:
# without it Prisma creates and drops a temporary schema on every run.
SHADOW_DATABASE_URL=
REDIS_URL=redis://localhost:6379
IA_LOCAL_ACTIVADA=true
IA_NUBE_ACTIVADA=false
PORT_API=3000
PG_PORT=5432
REDIS_PORT=6379

# CORS allowlist (SEC-01): explicit origins, comma-separated. Empty or unset
# reflects no cross-origin origin (curl/scripts still work; the web dev
# server on :4200 needs its origin listed).
CORS_ORIGINS=http://localhost:4200

# Login throttle (SEC-02): failed attempts per IP+user before blocking, and
# the window in minutes. The per-IP cap is 10x these attempts. Counters are
# in-memory per API instance (Redis migration is noted as debt).
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Ingestion (brief #12): where the untouched original bytes live (REGLAS.md 5:
# read-only after ingestion; never inside the repo) and the per-file size
# limit the server enforces.
ORIGINALS_DIR=./originales
UPLOAD_MAX_BYTES=52428800

# Google Drive/Docs — READ-ONLY and always live. Project OAuth credentials.
# The refresh token is used (grant refresh_token); the access_token
# expires and is never stored.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER=1KeJaYqEfrbD4H7hKCTIZsDMEAOolUdH4

# Project memory (index, not the source of truth)
ENGRAM_PROJECT=docu

# Systematic crawling (extra, off by default). Empty = keyless with limits.
# Used only per milestone with the lead's authorization (see .mcp.json: firecrawl).
FIRECRAWL_API_KEY=

# IA engines — one OpenAI-compatible endpoint serves every capability
# (ADR-0020). Default is Ollama local: http://localhost:11434/v1.
# A remote provider (NVIDIA NIM, OpenAI, company endpoint) additionally
# requires IA_NUBE_ACTIVADA=true (RNF-03) or the module refuses to start.
IA_API_BASE_URL=http://localhost:11434/v1
IA_API_KEY=
IA_OCR_MODEL=glm-ocr
IA_LLM_MODEL=llama3.2
# Registry tag of the Ollama library (colons, not dashes).
IA_EMBEDDING_MODEL=qwen3-embedding:0.6b
# Scoring engine with calibrated confidence (Laya / SystemOne-compatible,
# OCR.md §6). Same locality rules as IA_API_BASE_URL (RNF-03): a remote host
# additionally requires IA_NUBE_ACTIVADA=true.
IA_SCORING_URL=http://localhost:8000/v1/systemone
# Decision cascade thresholds (apps/api/src/ia/scoring.ts, initial values).
# The base enforces review <= automatic.
IA_SCORING_AUTO_THRESHOLD=0.90
IA_SCORING_REVIEW_THRESHOLD=0.60
IA_SEED=42
IA_TEMPERATURE=0
IA_BUDGET_MAX_MS=30000
IA_BUDGET_MAX_TOKENS=4000
IA_MAX_RETRIES=2
IA_CACHE_ENABLED=true
IA_CACHE_TTL_MS=3600000
# Live integration tests against the configured endpoint (brief #85).
# Never enable in CI: it spends real quota.
IA_LIVE_TEST=
