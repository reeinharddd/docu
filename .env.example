# Monday — tablero de producto DOCU 18432808588. Token personal: lo pone el
# lider en tu .env, nunca en el repositorio. Permisos: lectura automatica,
# escritura solo con peticion explicita.
MONDAY_API_KEY=
MONDAY_BOARD_ID=18432808588

# Google Drive/Docs — SOLO LECTURA y siempre en vivo. Credenciales OAuth del
# proyecto. Se usa el refresh token (grant refresh_token); el access_token
# caduca y no se guarda.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER=1KeJaYqEfrbD4H7hKCTIZsDMEAOolUdH4

# Memoria del proyecto (indice, no fuente de verdad)
ENGRAM_PROYECTO=docu
