DATABASE_URL=postgresql://docu:docu@localhost:5432/docu?schema=public
REDIS_URL=redis://localhost:6379
IA_LOCAL_ACTIVADA=true
IA_NUBE_ACTIVADA=false
JWT_SECRET=cambiar-en-tu-env-local
PORT_API=3000
PG_PORT=5432
REDIS_PORT=6379

# Google Drive/Docs — SOLO LECTURA y siempre en vivo. Credenciales OAuth del
# proyecto. Se usa el refresh token (grant refresh_token); el access_token
# caduca y no se guarda.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER=1KeJaYqEfrbD4H7hKCTIZsDMEAOolUdH4

# Memoria del proyecto (indice, no fuente de verdad)
ENGRAM_PROJECT=docu

# Crawling sistemático (extra, apagado por defecto). Vacía = keyless con límites.
# Se usa solo por hito con autorización del líder (ver .mcp.json: firecrawl).
FIRECRAWL_API_KEY=
