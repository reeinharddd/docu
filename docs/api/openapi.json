{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Todos los segmentos responden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReportDto"
                }
              }
            }
          },
          "503": {
            "description": "Algún segmento está caído: el cuerpo dice cuál (misma forma que el 200)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReportDto"
                }
              }
            }
          }
        },
        "tags": ["health"]
      }
    },
    "/v1/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Inicia sesión y devuelve el token opaco",
        "tags": ["auth"]
      }
    },
    "/v1/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "summary": "Revoca la sesión actual",
        "tags": ["auth"]
      }
    },
    "/v1/auth/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Perfil de la sesión activa",
        "tags": ["auth"]
      }
    },
    "/v1/families": {
      "get": {
        "operationId": "FamiliesController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": ["Families"]
      }
    },
    "/v1/families/{familyCode}": {
      "get": {
        "operationId": "FamiliesController_getByCode",
        "parameters": [
          {
            "name": "familyCode",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": ["Families"]
      }
    },
    "/v1/files": {
      "post": {
        "operationId": "FilesController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "familyCode": {
                    "type": "string"
                  }
                },
                "required": ["file", "familyCode"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "Registra un archivo de una familia; idempotente por (facility, sha256)",
        "tags": ["files"]
      }
    },
    "/v1/inbox": {
      "get": {
        "operationId": "InboxController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": ["Inbox"]
      }
    },
    "/v1/inbox/{id}/confirm": {
      "post": {
        "operationId": "InboxController_confirm",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": ["Inbox"]
      }
    },
    "/v1/inbox/{id}/reject": {
      "post": {
        "operationId": "InboxController_reject",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": ["Inbox"]
      }
    },
    "/v1/official-records": {
      "get": {
        "operationId": "OfficialRecordsController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": ["OfficialRecords"]
      }
    }
  },
  "info": {
    "title": "DOCU API",
    "description": "API de documentación digital — Configuración 1",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "WorkerHealthDto": {
        "type": "object",
        "properties": {
          "alive": {
            "type": "boolean",
            "description": "El worker publica su latido en Redis; si no está, no vive (ningún worker procesa la cola)"
          },
          "queues": {
            "type": "object",
            "description": "Profundidad por cola en el último latido",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "waiting": {
                  "type": "integer"
                },
                "active": {
                  "type": "integer"
                },
                "delayed": {
                  "type": "integer"
                },
                "failed": {
                  "type": "integer"
                },
                "completed": {
                  "type": "integer"
                },
                "paused": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "required": ["alive", "queues"]
      },
      "HealthReportDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok", "degraded"],
            "description": "ok solo si PostgreSQL, Redis y el worker responden; degraded en cualquier otro caso"
          },
          "postgres": {
            "type": "string",
            "enum": ["up", "down"],
            "description": "Sonda de PostgreSQL"
          },
          "redis": {
            "type": "string",
            "enum": ["up", "down"],
            "description": "Sonda de Redis"
          },
          "worker": {
            "$ref": "#/components/schemas/WorkerHealthDto"
          }
        },
        "required": ["status", "postgres", "redis", "worker"]
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      }
    }
  }
}
