{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "docs/REGLAS.md", "docs/decisiones/README.md"],
  "permission": {
    "bash": {
      "*": "ask",
      "bun install*": "allow",
      "bun run typecheck*": "allow",
      "bun run lint*": "allow",
      "bun run verify*": "allow",
      "bun run doctor*": "allow",
      "biome *": "allow",
      "bunx biome check*": "allow",
      "bunx tsc *": "allow",
      "curl *": "ask",
      "docker ps*": "allow",
      "git branch*": "allow",
      "git clean -f*": "deny",
      "git diff*": "allow",
      "git log*": "allow",
      "git push *": "ask",
      "git reset --hard*": "deny",
      "git status*": "allow",
      "rm *": "deny",
      "sudo *": "deny",
      "*compose down*": "ask",
      "*prune*": "ask",
      "*migrate reset*": "ask",
      "bun run setup*": "allow",
      "bash scripts/setup.sh*": "allow",
      "bash scripts/doc-index.sh*": "allow",
      "gh issue list*": "allow",
      "gh issue view*": "allow",
      "gh pr list*": "allow",
      "gh pr view*": "allow",
      "gh pr checks*": "allow",
      "gh pr diff*": "allow",
      "gh api user*": "allow",
      "gh repo view*": "allow",
      "gh auth status*": "allow",
      "gh issue create*": "ask",
      "gh issue edit*": "ask",
      "gh issue close*": "ask",
      "gh issue comment*": "ask",
      "gh issue develop*": "ask",
      "gh pr create*": "ask",
      "gh pr merge*": "ask",
      "gh api *": "ask",
      "gh issue delete*": "deny",
      "gh label delete*": "deny",
      "gh repo delete*": "deny",
      "git checkout*": "ask",
      "git switch*": "ask",
      "git add*": "ask",
      "git commit*": "ask"
    },
    "edit": {
      "*": "ask",
      ".env": "deny",
      ".env.*": "deny",
      ".github/workflows/*": "ask",
      "AGENTS.md": "ask",
      "infra/*": "ask"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "skill": {
      "*": "allow"
    }
  }
}
