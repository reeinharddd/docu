{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git#v6.4.2"],
  "mcp": {
    "engram": {
      "type": "local",
      "command": ["engram", "mcp", "--tools=agent", "--project=docu"],
      "enabled": true
    },
    "drive": {
      "type": "local",
      "command": [
        "npx",
        "mcp-remote",
        "https://drivemcp.googleapis.com/mcp/v1"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@0.0.83"],
      "enabled": false
    },
    "angular-cli": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@angular/cli@22.2.1",
        "mcp",
        "--read-only",
        "--local-only"
      ],
      "cwd": "apps/web",
      "enabled": false
    },
    "postgres": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres@0.6.2",
        "{env:DATABASE_URL}"
      ],
      "enabled": false
    },
    "redis": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/redis/mcp-redis.git@0.5.1",
        "redis-mcp-server",
        "--url",
        "redis://localhost:6379/0"
      ],
      "enabled": false
    },
    "firecrawl": {
      "type": "remote",
      "url": "https://mcp.firecrawl.dev/v2/mcp",
      "enabled": false,
      "oauth": false,
      "timeout": 30000,
      "headers": {
        "Authorization": "Bearer {env:FIRECRAWL_API_KEY}"
      }
    }
  },
  "instructions": ["AGENTS.md", "docs/REGLAS.md", "docs/decisiones/README.md"],
  "permission": {
    "bash": {
      "*": "ask",
      "bun install*": "allow",
      "bun run typecheck*": "allow",
      "bun run lint*": "allow",
      "bun run verify*": "allow",
      "bun run doctor*": "allow",
      "biome *": "allow",
      "bunx biome check*": "allow",
      "bunx tsc *": "allow",
      "curl *": "ask",
      "docker ps*": "allow",
      "git branch*": "allow",
      "git clean -f*": "deny",
      "git diff*": "allow",
      "git log*": "allow",
      "git push *": "ask",
      "git reset --hard*": "deny",
      "git status*": "allow",
      "rm *": "deny",
      "sudo *": "deny",
      "*compose down*": "ask",
      "*prune*": "ask",
      "*migrate reset*": "ask",
      "*DROP DATABASE*": "deny",
      "*DROP SCHEMA*": "deny",
      "*TRUNCATE*": "deny",
      "bun run setup*": "allow",
      "bash scripts/setup.sh*": "allow",
      "bash scripts/doc-index.sh*": "allow",
      "gh issue list*": "allow",
      "gh issue view*": "allow",
      "gh pr list*": "allow",
      "gh pr view*": "allow",
      "gh pr checks*": "allow",
      "gh pr diff*": "allow",
      "gh api user*": "allow",
      "gh repo view*": "allow",
      "gh auth status*": "allow",
      "gh issue create*": "ask",
      "gh issue edit*": "ask",
      "gh issue close*": "ask",
      "gh issue comment*": "ask",
      "gh issue develop*": "ask",
      "gh pr create*": "ask",
      "gh pr merge*": "ask",
      "gh api *": "ask",
      "gh issue delete*": "deny",
      "gh label delete*": "deny",
      "gh repo delete*": "deny",
      "git checkout*": "ask",
      "git switch*": "ask",
      "git add*": "ask",
      "git commit*": "ask"
    },
    "edit": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      ".github/workflows/*": "ask",
      "AGENTS.md": "ask",
      "opencode.json": "ask",
      "infra/*": "ask"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "skill": {
      "*": "allow"
    },
    "lsp": {
      "*": "allow"
    }
  }
}
