{
  "name": "DOCU uniforme",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/oven-sh/bun:1": { "version": "latest" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "biomejs.biome",
        "oven.bun-vscode",
        "angular.ng-template",
        "bradlc.vscode-tailwindcss",
        "prisma.prisma"
      ]
    }
  },
  "postCreateCommand": "bun install"
}
