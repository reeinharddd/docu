{
  "name": "docu",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:web": "bun --filter web start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "bun --filter '*' typecheck",
    "postinstall": "lefthook install"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "dotenv": "^18.0.5",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@evilmartians/lefthook": "^2.1.17",
    "@types/pg": "^8.23.1"
  },
  "packageManager": "bun@1.4.2"
}
