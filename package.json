{
  "name": "docu",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "bash scripts/dev.sh",
    "dev:web": "bun --filter web start",
    "doctor": "bash scripts/doctor.sh",
    "verify": "bun run lint && bun run typecheck && bun run compose:check && bash scripts/doc-index.sh && bun --filter web test && bun run smoke:api",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "typecheck": "bun --filter '*' typecheck",
    "smoke:api": "bash scripts/smoke-api.sh",
    "compose:check": "docker compose -f infra/docker-compose.yml config >/dev/null",
    "docs:links": "bash scripts/docs-linkcheck.sh",
    "docs:briefs": "bash scripts/docs-briefcheck.sh",
    "docs:trace": "bash scripts/docs-tracecheck.sh",
    "postinstall": "lefthook install",
    "project:sync": "bun scripts/project-sync.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@evilmartians/lefthook": "^2.1.17"
  },
  "packageManager": "bun@1.4.2"
}
