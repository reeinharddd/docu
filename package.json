{
  "name": "docu",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "bootstrap": "bash scripts/bootstrap-backend.sh",
    "dev": "bash scripts/dev.sh",
    "dev:web": "bun --filter web start",
    "doctor": "bash scripts/doctor.sh",
    "verify": "bun run db:generate && bun run lint && bun run typecheck && bun run compose:check && bun run harness:check && bun run diagramas:check && bun run dataset:check && bun run contrato:check && bun run prisma:check && bun run seed:check && bash scripts/doc-index.sh && bun --filter @docu/api test && bun --filter web test && bun run api:openapi:check && bun run smoke:api",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "typecheck": "bun --filter '*' typecheck",
    "smoke:api": "bash scripts/smoke-api.sh",
    "compose:check": "docker compose -f infra/docker-compose.yml config >/dev/null",
    "harness:check": "bash scripts/harness-check.sh",
    "diagramas:check": "bun scripts/diagramas-check.ts",
    "diagramas:drawio": "sh scripts/diagramas-drawio.sh",
    "dataset:check": "bun scripts/dataset-check.ts",
    "contrato:check": "bun scripts/contrato-sha.ts",
    "contrato:freeze": "bun scripts/contrato-sha.ts --freeze",
    "prisma:check": "bun scripts/prisma-check.ts",
    "seed:check": "bun scripts/seed-check.ts",
    "db:validate": "bun --filter @docu/api db:validate",
    "db:generate": "bun --filter @docu/api db:generate",
    "db:migrate": "bun --filter @docu/api db:migrate",
    "db:deploy": "bun --filter @docu/api db:deploy",
    "db:test": "bun --filter @docu/api db:test",
    "db:spec": "bun --filter @docu/api db:spec",
    "test:e2e": "bun --filter @docu/api test:e2e",
    "worker": "bun --filter @docu/api worker",
    "db:seed": "bun --filter @docu/api db:seed",
    "db:password": "bun --filter @docu/api db:password",
    "api:openapi": "bun --filter @docu/api openapi",
    "api:openapi:check": "bun --filter @docu/api openapi:check",
    "docs:links": "bash scripts/docs-linkcheck.sh",
    "docs:briefs": "bash scripts/docs-briefcheck.sh",
    "docs:trace": "bash scripts/docs-tracecheck.sh",
    "postinstall": "lefthook install",
    "project:sync": "bun scripts/project-sync.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@evilmartians/lefthook": "^2.1.17",
    "jsdom": "30.1.2",
    "mermaid": "11.17.2"
  },
  "packageManager": "bun@1.4.3"
}
